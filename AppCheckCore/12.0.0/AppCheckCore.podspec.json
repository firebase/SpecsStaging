{
  "name": "AppCheckCore",
  "version": "12.0.0",
  "summary": "App Check Core SDK.",
  "description": "SDK for anti-abuse compatibility.",
  "homepage": "https://firebase.google.com",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": "Google, Inc.",
  "source": {
    "git": "https://github.com/google/app-check.git",
    "tag": "CocoaPods-12.0.0"
  },
  "social_media_url": "https://twitter.com/Firebase",
  "swift_versions": "5.9",
  "platforms": {
    "ios": "15.0",
    "osx": "11.0",
    "tvos": "15.0",
    "watchos": "8.0"
  },
  "cocoapods_version": ">= 1.4.0",
  "prefix_header_file": false,
  "source_files": [
    "AppCheckCore/Sources/**/*.{h,m,swift}"
  ],
  "ios": {
    "source_files": [
      "AppCheckRecaptchaProvider/Sources/**/*.swift"
    ],
    "weak_frameworks": "DeviceCheck",
    "dependencies": {
      "RecaptchaInterop": [
        "~> 101.0"
      ]
    }
  },
  "public_header_files": "AppCheckCore/Sources/Public/AppCheckCore/*.h",
  "osx": {
    "weak_frameworks": "DeviceCheck"
  },
  "tvos": {
    "weak_frameworks": "DeviceCheck"
  },
  "dependencies": {
    "GoogleUtilities/Environment": [
      "~> 8.0"
    ],
    "GoogleUtilities/UserDefaults": [
      "~> 8.0"
    ]
  },
  "pod_target_xcconfig": {
    "GCC_C_LANGUAGE_STANDARD": "c99",
    "HEADER_SEARCH_PATHS": "\"${PODS_TARGET_SRCROOT}\""
  },
  "testspecs": [
    {
      "name": "unit",
      "test_type": "unit",
      "platforms": {
        "ios": "15.0",
        "osx": "11.0",
        "tvos": "15.0"
      },
      "source_files": [
        "AppCheckCore/Tests/Unit/**/*.swift",
        "AppCheckCore/Tests/Unit/ObjC/**/*.m"
      ],
      "resources": "AppCheckCore/Tests/Fixture/**/*",
      "requires_app_host": true
    },
    {
      "name": "integration",
      "test_type": "unit",
      "platforms": {
        "ios": "15.0",
        "osx": "11.0",
        "tvos": "15.0"
      },
      "source_files": [
        "AppCheckCore/Tests/Integration/**/*.swift"
      ],
      "resources": "AppCheckCore/Tests/Fixture/**/*",
      "requires_app_host": true
    },
    {
      "name": "swift-unit",
      "test_type": "unit",
      "platforms": {
        "ios": "15.0",
        "osx": "11.0",
        "tvos": "15.0"
      },
      "source_files": [
        "AppCheckCore/Tests/Unit/Swift/**/*.swift",
        "AppCheckCore/Tests/Unit/Swift/**/*.h"
      ]
    }
  ],
  "swift_version": "5.9"
}
