{
  "name": "FirebaseAppCheckInterop",
  "version": "13.0.0",
  "summary": "Interfaces that allow other Firebase SDKs to use AppCheck functionality.",
  "description": "Not for public use.\nA set of protocols that other Firebase SDKs can use to interoperate with FirebaseAppCheck in a safe\nand reliable manner.",
  "homepage": "https://firebase.google.com",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": "Google, Inc.",
  "source": {
    "git": "https://github.com/firebase/firebase-ios-sdk.git",
    "tag": "CocoaPods-13.0.0"
  },
  "social_media_url": "https://twitter.com/Firebase",
  "platforms": {
    "ios": "15.0",
    "osx": "11.0",
    "tvos": "15.0",
    "watchos": "8.0"
  },
  "source_files": "FirebaseAppCheck/Interop/**/*.[hm]",
  "public_header_files": "FirebaseAppCheck/Interop/Public/FirebaseAppCheckInterop/*.h",
  "pod_target_xcconfig": {
    "PRODUCT_BUNDLE_IDENTIFIER": "com.google.firebase.FirebaseAppCheckInterop"
  },
  "testspecs": [
    {
      "name": "objc-unit",
      "test_type": "unit",
      "platforms": {
        "ios": "15.0",
        "osx": "11.0",
        "tvos": "15.0"
      },
      "source_files": [
        "FirebaseAppCheck/Tests/Interop/ObjC/**/*.[hm]"
      ]
    },
    {
      "name": "swift-unit",
      "test_type": "unit",
      "platforms": {
        "ios": "15.0",
        "osx": "11.0",
        "tvos": "15.0"
      },
      "source_files": [
        "FirebaseAppCheck/Tests/Interop/Swift/**/*.swift"
      ]
    }
  ]
}
